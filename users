                "rbxthumb://type=AvatarHeadShot&id="
                .. userId .. "&w=48&h=48"
        end
    end)

    -- Username

    local UsernameButton = Instance.new("TextButton")
    UsernameButton.Size = UDim2.new(1, -105, 1, 0)
    UsernameButton.Position = UDim2.new(0, 52, 0, 0)
